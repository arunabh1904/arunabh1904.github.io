---
import Icon from './Icon.astro';
import MusicPlayer from './MusicPlayer.astro';

interface Props {
  showHomeButton?: boolean;
  showMusicButton?: boolean;
}

const { showHomeButton = false, showMusicButton = true } = Astro.props;
---

<div class="page-controls" data-page-controls>
  {showMusicButton && (
    <div
      class="page-controls__item page-controls__item--music"
      data-music-controller
      transition:persist="music-dock"
    >
      <button
        type="button"
        class="small-rounded-button icon-only-button page-controls__button page-controls__button--music"
        aria-label="Open music player"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="music-player"
        data-music-open
      >
        <Icon name="music" class="button-icon" />
      </button>
      <MusicPlayer />
    </div>
  )}
  <button
    type="button"
    class="small-rounded-button icon-only-button page-controls__button page-controls__button--theme"
    aria-label="Toggle theme"
    data-theme-toggle
  >
    <Icon name="moon" class="button-icon theme-icon theme-icon-moon" />
    <Icon name="sun" class="button-icon theme-icon theme-icon-sun" />
  </button>

  {showHomeButton && (
    <a
      href="/"
      class="small-rounded-button icon-only-button page-controls__button page-controls__button--home"
      aria-label="Go home"
      data-home-button
    >
      <Icon name="arrow-left" class="button-icon" />
    </a>
  )}
</div>
