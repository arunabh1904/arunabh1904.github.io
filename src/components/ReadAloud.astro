---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<section class="read-aloud" data-read-aloud aria-label={`Listen to ${title}`}>
  <div class="read-aloud__header">
    <button
      type="button"
      class="read-aloud__toggle"
      data-read-aloud-toggle
      aria-label={`Listen to ${title}`}
      aria-pressed="false"
    >
      <span class="read-aloud__play-icon" data-read-aloud-icon aria-hidden="true">▶</span>
      <span data-read-aloud-label>Listen</span>
    </button>
    <span class="read-aloud__hint">Read this post aloud</span>
    <label class="read-aloud__speed">
      <span>Speed</span>
      <select data-read-aloud-speed aria-label="Playback speed">
        <option value="0.8">0.8×</option>
        <option value="1" selected>1×</option>
        <option value="1.2">1.2×</option>
        <option value="1.5">1.5×</option>
        <option value="2">2×</option>
      </select>
    </label>
  </div>
  <div class="read-aloud__timeline">
    <input
      type="range"
      min="0"
      max="100"
      value="0"
      step="0.1"
      data-read-aloud-progress
      aria-label="Audio progress"
    />
    <span class="read-aloud__time" data-read-aloud-current>0:00</span>
    <span aria-hidden="true">/</span>
    <span class="read-aloud__time" data-read-aloud-duration>--:--</span>
  </div>
  <audio class="read-aloud__native" data-read-aloud-audio controls preload="metadata" src={src}>
    <a href={src}>Download the audio for this post</a>
  </audio>
</section>

<script>
  import { initReadAloud } from '../lib/read-aloud';

  initReadAloud();
  document.addEventListener('astro:page-load', () => initReadAloud());
</script>
