---
import PageControls from '../components/PageControls.astro';
import PostNavigation from '../components/PostNavigation.astro';
import ReadAloud from '../components/ReadAloud.astro';
import type { PostEntry } from '../lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  previous?: PostEntry;
  next?: PostEntry;
  navigationContext?: {
    href: string;
    label: string;
    position: number;
    total: number;
  };
  showNavigation?: boolean;
  showSectionsNav?: boolean;
  readAloudAudio?: string;
}

const {
  title,
  description,
  previous,
  next,
  navigationContext,
  showNavigation = false,
  showSectionsNav = true,
  readAloudAudio,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageControls showHomeButton={true} />
  <div class={`page-layout${showSectionsNav ? '' : ' page-layout--centered'}`}>
    <main class="page-content page-content--narrow" aria-label="Content" data-sections-root>
      {readAloudAudio && <ReadAloud src={readAloudAudio} title={title} />}
      <slot />
      {
        showNavigation && (
          <PostNavigation previous={previous} next={next} context={navigationContext} />
        )
      }
    </main>
    {
      showSectionsNav && (
        <aside class="sections-nav" aria-label="Sections" data-sections-nav hidden>
          <div class="sections-nav__inner">
            <p class="sections-nav__eyebrow">Sections</p>
            <nav class="sections-nav__links" data-sections-list></nav>
          </div>
        </aside>
      )
    }
  </div>
</BaseLayout>
